# Sync results: keep small artifacts (json/log/figures) for sharing, but ignore heavy blobs.
_sync/**
!_sync/**/
!_sync/**/*.json
!_sync/**/*.jsonl
!_sync/**/*.log
!_sync/**/*.md
!_sync/**/*.png
!_sync/**/*.pdf
!_sync/**/*.svg
!_sync/**/*.csv
!_sync/**/*.npz
*.pt
*.pth
*.ckpt

# Legacy Shenzhen (keep raw blobs local)
legacy/shenzhen/track_data/**/TaxiData
legacy/shenzhen/track_data/**/*.rar

